# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Optional. Enables Google Maps Platform basemap tiles.
# Required for Google-quality STREET / SATELLITE / HYBRID / TERRAIN basemaps.
# When not set, the map falls back to free Esri + OpenStreetMap tiles (no key required).
# Obtain from: https://console.cloud.google.com/apis/credentials
# Enable the "Maps Tiles API" in your Google Cloud project.
# IMPORTANT: Restrict the key to HTTP referrers: localhost:3000/* and your production domain.
VITE_GOOGLE_MAPS_API_KEY=""

# Backend-only Google Maps key (for tile proxy or server-side usage, future enhancement).
GOOGLE_MAPS_API_KEY=""
